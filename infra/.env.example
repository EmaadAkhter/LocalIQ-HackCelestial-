# Copy to .env and adjust. Used by both compose files.

# ---- Postgres ----
POSTGRES_USER=localiq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=localiq

# ---- Backend ----
APP_ENV=production
# Comma-separated allowed browser origins. Same-origin traffic through the
# tunnel needs no entry; these cover local dev servers and the public host.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,https://localiq.tavesglobal.com

# ---- Hardening (Phase 1) ----
LOG_JSON=true
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Database pool (Postgres only; SQLite uses StaticPool) ----
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800

# ---- LLM robustness ----
# LLM_PARSE_TIMEOUT_SECONDS=20
# LLM_CHAT_TIMEOUT_SECONDS=30
# LLM_WARM_TIMEOUT_SECONDS=5
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF_SECONDS=0.5
# LLM_CACHE_ENABLED=true
# LLM_CACHE_TTL_SECONDS=300

# ---- Caching & images ----
# WEATHER_CACHE_TTL_SECONDS=600
# RECOMMEND_CACHE_ENABLED=true
# RECOMMEND_CACHE_TTL_SECONDS=60
# IMAGE_PLACEHOLDER_URL_TEMPLATE=https://picsum.photos/seed/{seed}/800/600

# ---- LLM: local mode (docker-compose.yml) ----
# Talks to Ollama running on your host machine.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_API_KEY=

# ---- LLM: remote mode (docker-compose.remote-llm.yml) ----
# Point at the shared, tunnelled Ollama exposed through Kong key-auth.
# OLLAMA_URL=https://<shared-tunnel-host>/llm
# OLLAMA_API_KEY=localiq-shared-key

# ---- Edge ----
HTTP_PORT=8080

# ---- Flutter web build output (once built) ----
# FLUTTER_WEB_DIR=../frontend_flutter/build/web
