# Copy to .env and adjust.

JENKINS_PORT=8081
JENKINS_AGENT_PORT=50000
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-strong
JENKINS_URL=http://localhost:8081/
GITHUB_REPO_URL=https://github.com/EmaadAkhter/LocalIQ-HackCelestial-.git

# Docker socket for the daemon you use:
#   Docker Desktop: /var/run/docker.sock
#   Colima:         /Users/<you>/.colima/default/docker.sock
DOCKER_SOCK=/var/run/docker.sock
