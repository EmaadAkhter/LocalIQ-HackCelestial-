# Copy to .env and adjust as needed. Never commit .env.

# ---- App ----
APP_ENV=development
# Comma-separated list of allowed CORS origins (Flutter web dev server + tunnel URL).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Set true to force pre-written (canned) LLM responses for a stable demo.
DEMO_MODE=false

# ---- Database ----
# Local dev without a server: SQLite
DATABASE_URL=sqlite:///./data/localiq.db
# Docker / production: PostgreSQL
# DATABASE_URL=postgresql+psycopg2://localiq:localiq@localhost:5432/localiq

# ---- Auth (local, self-hosted) ----
# Change this before sharing the app; it signs session tokens.
AUTH_SECRET_KEY=localiq-dev-secret-change-me
AUTH_TOKEN_TTL_MINUTES=10080

# ---- Local LLM (Ollama) ----
# Leave OLLAMA_MODEL empty to run fully on deterministic fallbacks.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=30
# Consume a shared, tunnelled Ollama behind Kong key-auth:
# OLLAMA_URL=https://<shared-host>/llm
# OLLAMA_API_KEY=localiq-shared-key

# ---- External services (optional, demo-only enhancements) ----
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# ---- Google Maps (one key per platform, restricted in the Cloud console) ----
# The web key is served to browsers by GET /api/v1/config. Never commit real
# keys: this file is the template, put the real values in backend/.env.
# Web (Maps JavaScript API) - restrict by HTTP referrer.
GOOGLE_MAPS_API_KEY_WEB=
# Android - restrict by package name + SHA-1 signing certificate.
GOOGLE_MAPS_API_KEY_ANDROID=
# iOS - restrict by bundle id.
GOOGLE_MAPS_API_KEY_IOS=

# ---- Google server-side APIs (never sent to any client) ----
# These are used only inside this process. They are separate from the client map
# keys above so they can be restricted by IP; the same key may be reused here
# when you have only one credential to hand.
#   GOOGLE_PLACES_API_KEY -> Places API (New): search, nearby, photo proxy
#   GOOGLE_ROUTES_API_KEY  -> Routes API: travel time, distance, polyline
# Leave both empty to run fully offline on the SQLite dataset.
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=

# ---- Google server APIs (NEVER sent to any client) ----
# These are separate, server-restricted keys (restrict by IP + enable only the
# Places / Routes APIs). They are used only inside the FastAPI process.
# Leave both empty to run fully offline on the SQLite dataset.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_ROUTES_API_KEY=