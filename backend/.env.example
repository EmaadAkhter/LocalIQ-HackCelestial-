# Copy to .env and adjust as needed. Never commit .env.

# ---- App ----
APP_ENV=development
# Comma-separated list of allowed CORS origins (Flutter web dev server + tunnel URL).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Set true to force pre-written (canned) LLM responses for a stable demo.
DEMO_MODE=false

# ---- Database ----
# Local dev without a server: SQLite
DATABASE_URL=sqlite:///./data/localiq.db
# Docker / production: PostgreSQL
# DATABASE_URL=postgresql+psycopg2://localiq:localiq@localhost:5432/localiq

# ---- Auth (local, self-hosted) ----
# Change this before sharing the app; it signs session tokens.
AUTH_SECRET_KEY=localiq-dev-secret-change-me
AUTH_TOKEN_TTL_MINUTES=10080

# ---- Local LLM (Ollama) ----
# Leave OLLAMA_MODEL empty to run fully on deterministic fallbacks.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=30
# Consume a shared, tunnelled Ollama behind Kong key-auth:
# OLLAMA_URL=https://<shared-host>/llm
# OLLAMA_API_KEY=localiq-shared-key

# ---- External services (optional, demo-only enhancements) ----
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# Google Maps JS API key is used client-side; server-side key (if any) stays private here.
GOOGLE_MAPS_API_KEY=
