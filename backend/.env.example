# Copy to .env and adjust as needed.

# ---- App ----
APP_ENV=development
# Comma-separated list of allowed CORS origins (frontend dev server + tunnel URL).
CORS_ORIGINS=http://localhost:3000

# ---- Database (local SQLite file) ----
DATABASE_URL=sqlite:///./data/localiq.db

# ---- Local LLM (Ollama) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=30

# ---- External services (optional, demo-only enhancements) ----
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# Google Maps JS API key is used client-side; server-side key (if any) stays private here.
GOOGLE_MAPS_API_KEY=
