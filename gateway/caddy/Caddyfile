# LocalIQ edge proxy.
# Sits behind Cloudflare Tunnel (TLS terminated at the Cloudflare edge), so
# auto-HTTPS is disabled here. Routes API + shared LLM to Kong, everything
# else to the static Flutter web build.

{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	route /api/* {
		reverse_proxy kong:8000
	}

	route /llm/* {
		reverse_proxy kong:8000
	}

	route /healthz {
		respond "ok" 200
	}

	# Readiness needs the real backend (DB + Ollama), so proxy it.
	route /readyz {
		reverse_proxy backend:8000
	}

	# FastAPI docs. These live outside /api, so they bypass Kong and go
	# straight to the backend (same network). Handy for demos and judging.
	route /docs* {
		reverse_proxy backend:8000
	}

	route /redoc* {
		reverse_proxy backend:8000
	}

	route /openapi.json {
		reverse_proxy backend:8000
	}

	# NOTE: /metrics is intentionally NOT routed here. Prometheus scrapes the
	# backend from inside the network so metrics aren't exposed on the tunnel.

	# Experience photos and uploaded media are served by the backend. Without
	# these the Flutter web SPA fallback would answer with index.html.
	route /static/* {
		reverse_proxy backend:8000
	}

	route /media/* {
		reverse_proxy backend:8000
	}

	route {
		reverse_proxy nginx-flutter:80
	}
}
